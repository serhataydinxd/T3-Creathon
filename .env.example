# The public demo works without environment variables in replay mode.
APP_MODE=replay

# Required when persistence is enabled.
DATABASE_URL=postgresql://imkan:imkan-local-only@localhost:54329/imkan
DATABASE_SSL=false

# Never commit provider credentials.
LLM_API_KEY=

# Seed-only local demo password. Change this outside local development.
DEMO_PASSWORD=I.mkanDemo!2026

# Production-only one-time manager bootstrap. Prefer injecting the password
# from an ephemeral secret rather than placing it in a file.
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_NAME=
BOOTSTRAP_MANAGER_PASSWORD=
